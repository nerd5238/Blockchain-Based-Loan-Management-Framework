# ── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/hybrid_banking

# ── Blockchain (Ganache) ──────────────────────────────────
BLOCKCHAIN_RPC=http://127.0.0.1:7545          # Ganache GUI (use 8545 for ganache-cli)

# Paste the CONTRACT ADDRESS printed after "truffle migrate"
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# First account from Ganache — used to sign transactions (backend wallet, no crypto)
BLOCKCHAIN_ACCOUNT=0xYourGanacheAccount0

# ── Server ────────────────────────────────────────────────
PORT=3000
